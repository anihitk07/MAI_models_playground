# ============================================================
# MAI Model Demo — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to source control.
# ============================================================

# ── Azure Speech: MAI-Transcribe-1 (Speech-to-Text) ─────────
# Found in: Azure Portal > your Speech resource (Transcribe) > Keys and Endpoint
TRANSCRIBE_SPEECH_KEY=your_transcribe_speech_key_here
TRANSCRIBE_SPEECH_REGION=eastus
# Supported regions for MAI-Transcribe-1: eastus, westus

# Local audio folder for transcription notebook demos
# Example: C:\Flutter\azure-transcription\demodata
TRANSCRIBE_LOCAL_AUDIO_DIR=C:\Flutter\azure-transcription\demodata

# ── Azure Speech: MAI-Voice-1 (Text-to-Speech) ─────────────
# Found in: Azure Portal > your Speech resource (Voice) > Keys and Endpoint
VOICE_SPEECH_KEY=your_voice_speech_key_here
VOICE_SPEECH_REGION=swedencentral
# Supported regions for MAI-Voice-1: centralus, japanwest, swedencentral

# Optional legacy fallback vars (kept for backward compatibility in notebooks)
# SPEECH_KEY=
# SPEECH_REGION=

# ── MAI-Voice-1 voice name ──────────────────────────────────
# The voice name for MAI-Voice-1 from the curated voice library.
# Find the full list in Azure Speech Studio > Voice Gallery.
# Example: en-US-MAIVoice1Neural
MAI_VOICE_NAME=en-us-Grant:MAI-Voice-1

# ── MAI-Image-2 / MAI-Image-2e (Microsoft Foundry) ─────────
# Found in: Foundry portal > your resource > Keys and Endpoint
AZURE_FOUNDRY_ENDPOINT=https://<your-resource-name>.services.ai.azure.com/
AZURE_FOUNDRY_API_KEY=your_foundry_api_key_here

# Deployment names you assigned in the Foundry portal
MAI_IMAGE_2_DEPLOYMENT_NAME=mai-image-2
MAI_IMAGE_2E_DEPLOYMENT_NAME=MAI-Image-2e

# ── Optional: Microsoft Entra ID (managed identity auth) ───
# Leave blank to use API key auth above.
# Set USE_ENTRA_AUTH=true to switch to Entra ID token auth.
USE_ENTRA_AUTH=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
