        "allowProjectManagement": "[parameters('allowProjectManagement')]",
        "publicNetworkAccess": "[parameters('publicNetworkAccess')]"
      }
    }
  ],
  "outputs": {
    "accountId": {
      "type": "string",
      "value": "[resourceId('Microsoft.CognitiveServices/accounts', parameters('accountName'))]"
