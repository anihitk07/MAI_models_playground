{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "77997176591419327"
    }
  },
  "parameters": {
    "accountName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Foundry account that will host this project."
      }
    },
    "projectName": {
      "type": "string",
      "metadata": {
        "description": "Foundry project name."
      }
    },
    "location": {
      "type": "string",
      "metadata": {
        "description": "Azure region for the project."
      }
    },
    "displayName": {
      "type": "string",
      "defaultValue": "MAI Models Project",
      "metadata": {
        "description": "Display name shown in Foundry."
      }
    },
    "projectDescription": {
      "type": "string",
      "defaultValue": "Project for MAI model demos.",
      "metadata": {
        "description": "Project description."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.CognitiveServices/accounts/projects",
      "apiVersion": "2025-04-01-preview",
      "name": "[format('{0}/{1}', parameters('accountName'), parameters('projectName'))]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "displayName": "[parameters('displayName')]",
        "description": "[parameters('projectDescription')]"
      }
    }
  ],
  "outputs": {
    "projectName": {
      "type": "string",
      "value": "[parameters('projectName')]"
    },
    "projectManagedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('accountName'), parameters('projectName')), '2025-04-01-preview', 'full').identity.principalId]"
    },
    "projectEndpoint": {
      "type": "string",
      "value": "[format('https://{0}.services.ai.azure.com/api/projects/{1}', parameters('accountName'), parameters('projectName'))]"
    }
  }
}