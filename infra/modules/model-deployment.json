{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "18113980986979221573"
    }
  },
  "parameters": {
    "accountName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Foundry account hosting the deployment."
      }
    },
    "deploymentName": {
      "type": "string",
      "metadata": {
        "description": "Deployment name."
      }
    },
    "modelName": {
      "type": "string",
      "metadata": {
        "description": "Model name from catalog."
      }
    },
    "modelFormat": {
      "type": "string",
      "defaultValue": "OpenAI",
      "metadata": {
        "description": "Model format (for example: OpenAI)."
      }
    },
    "modelVersion": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional model version from catalog."
      }
    },
    "skuName": {
      "type": "string",
      "defaultValue": "GlobalStandard",
      "metadata": {
        "description": "Deployment SKU."
      }
    },
    "capacity": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "metadata": {
        "description": "SKU capacity for deployment."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2025-04-01-preview",
      "name": "[format('{0}/{1}', parameters('accountName'), parameters('deploymentName'))]",
      "sku": {
        "name": "[parameters('skuName')]",
        "capacity": "[parameters('capacity')]"
      },
      "properties": {
        "model": "[if(empty(parameters('modelVersion')), createObject('format', parameters('modelFormat'), 'name', parameters('modelName')), createObject('format', parameters('modelFormat'), 'name', parameters('modelName'), 'version', parameters('modelVersion')))]"
      }
    }
  ],
  "outputs": {
    "deploymentName": {
      "type": "string",
      "value": "[parameters('deploymentName')]"
    }
  }
}